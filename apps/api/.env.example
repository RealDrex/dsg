# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgres://bestprice:bestprice@localhost:5432/bestprice
# At least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes
# Comma separated origins allowed by CORS (admin panel, web build). Mobile apps don't need CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Public base URL used to build outbound /r/ links
PUBLIC_BASE_URL=http://localhost:4000
# Optional: enables the Claude-powered assistant AND online product lookup (web search for products
# that aren't in the catalog). Without it the rule-based advisor answers and search covers the catalog only.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
# Web search for products (text, barcode or photo). The faster model answers in ~15–40 s; claude-opus-5-5 searches deeper but slower.
DISCOVERY_MODEL=claude-sonnet-5-5
# low | medium | high: how hard the search model works before answering
DISCOVERY_EFFORT=low
# Optional, product photos: image search (https://brave.com/search/api/). Without it photos come from
# store pages and Wikipedia.
BRAVE_SEARCH_API_KEY=
# Optional, sharper store/brand logos (https://www.logo.dev). Without it each site's own icon is used.
LOGO_DEV_TOKEN=
# First admin account, created by `npm run db:seed` if it doesn't exist
ADMIN_EMAIL=admin@bestprice.local
ADMIN_PASSWORD=
# Demo catalog and demo prices (clearly labelled as demo data). Set to false once web search is on:
# demo prices are then hidden (and shown again if you set it back to true).
SEED_DEMO_DATA=true
# Online product lookups per user per day (each one is a paid web search)
FREE_DISCOVERY_DAILY=15
PRO_DISCOVERY_DAILY=100
TRUST_PROXY=false
